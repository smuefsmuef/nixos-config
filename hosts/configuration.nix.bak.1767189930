{ config, lib, pkgs, unstable, inputs, vars, sops-nix, ... }:

let
  # Importiere die module-Listen (die Module-Files liefern Listen)
  desktopModules = import ../modules/desktops;
  editorModules  = import ../modules/editors;
  hardwareModules= import ../modules/hardware;
  programModules = import ../modules/programs;
  serviceModules = import ../modules/services;
  shellModules   = import ../modules/shell;
  themeModules   = import ../modules/theming;

  allModuleFolders = lib.concatLists [
    desktopModules
    editorModules
    hardwareModules
    programModules
    serviceModules
    shellModules
    themeModules
  ];
in
{
  ########################################################
  # imports (sops + home-manager + eigene module)
  ########################################################
  imports = [
    inputs.sops-nix.nixosModules.sops
    inputs.home-manager.nixosModules.home-manager
  ] ++ allModuleFolders;

  ########################################################
  # Grundlegende Einstellungen
  ########################################################
  system.stateVersion = "25.05";

  time.timeZone = "Europe/Zurich";
  i18n = {
    defaultLocale = "en_US.UTF-8";
    extraLocaleSettings = {
      LC_TIME = "en_US.UTF-8";
      LC_MONETARY = "en_US.UTF-8";
    };
  };

  console = {
    font = "Lat2-Terminus16";
    keyMap = "sg";
  };

  swapDevices = [
    {
      device = "/swapfile";
      size = 16 * 1024; # 16 GB
    }
  ];

  ########################################################
  # Benutzer / sops secret placeholders (wie vorher)
  ########################################################
  sops.defaultSopsFile = ./../secrets/secrets.yaml;
  sops.defaultSopsFormat = "yaml";
  sops.age.keyFile = "/home/${vars.user}/MEGAsync/encrypt/nixos/keys.txt";

  sops.secrets.home-path = { };
  sops.secrets."my-secret" = { owner = "${vars.user}"; };

  users.groups.secrets = { };

  users.users.${vars.user} = {
    isNormalUser = true;
    extraGroups = [ "wheel" "video" "audio" "camera" "networkmanager" "lp" "scanner" "secrets" ];
  };

  ########################################################
  # Fonts (ohne nerdfonts-legacy)
  ########################################################
  fonts.packages = with pkgs; [
    carlito
    vegur
    source-code-pro
    jetbrains-mono
    font-awesome
    corefonts
    ubuntu_font_family
  ];
  fonts.fontconfig.enable = lib.mkForce true;

  ########################################################
  # Networking
  ########################################################
  networking.nameservers = [ "1.1.1.1" "9.9.9.9" ];

  ########################################################
  # Environment / systemPackages (hier die Programme)
  # - entfernte veraltete Einträge (gnome.gnome-remote-desktop,
  #   environment.excludePackages, nerdfonts.override etc.)
  ########################################################
  environment = {
    variables = {
      TERMINAL = "${vars.terminal}";
      EDITOR   = "${vars.editor}";
      VISUAL   = "${vars.editor}";
    };

    systemPackages = with pkgs; [
      # basics
      btop coreutils git glxinfo hwinfo killall lshw nano
      nix-tree nixpkgs-fmt pciutils psmisc ranger screen tldr usbutils wget xdg-utils binutils vscode

      # password / crypto
      pass gnupg pinentry

      # multimedia / dev tools
      alsa-utils audacity feh mpv pavucontrol pipewire pulseaudio vlc openshot-qt figma-linux

      # apps
      appimage-run google-chrome libreoffice vivaldi

      # file mgmt
      file-roller pcmanfm p7zip rsync unzip unrar zip pdfarranger

      # misc
      sops yarn slack gradle maven python3 libGL php php82Packages.composer processing mesa jogl
      brave discord docker-compose firefox gedit gimp gparted quickemu htop lsof netbird netbird-ui
      openvpn qbittorrent remmina spotify steam stremio strongswan megasync openssl clockify postman

      # dev extras
      (jetbrains.plugins.addPlugins jetbrains.idea-ultimate [ "github-copilot" ])
    ] ++ (with unstable; [
      # optional unstable pkgs here
    ]);
  };

  ########################################################
  # Programs / services
  ########################################################
  programs = {
    gamemode.enable = false;
    java.enable = true;
  };

  services = {
    printing.enable = true;

    avahi = {
      enable = true;
      nssmdns4 = true;
      openFirewall = true;
    };

    pipewire = {
      enable = true;
      alsa = {
        enable = true;
        support32Bit = true;
      };
      pulse = { enable = true; };
      jack = { enable = true; };
    };

    openssh = {
      enable = true;
      allowSFTP = true;
      extraConfig = ''
        HostKeyAlgorithms +ssh-rsa
      '';
    };

    strongswan.enable = true;
    netbird.enable = true;
  };

  ########################################################
  # nix / flake / store settings
  ########################################################
  nix = {
    settings = {
      auto-optimise-store = true;
      experimental-features = "nix-command flakes";
    };
    gc = {
      automatic = true;
      dates = "weekly";
      options = "--delete-older-than 7d";
    };
    package = pkgs.nixVersions.latest;
    registry.nixpkgs.flake = inputs.nixpkgs;
    extraOptions = ''
      experimental-features = nix-command flakes
      keep-outputs          = true
      keep-derivations      = true
    '';
  };

  nixpkgs.config = {
    allowUnfree = true;
    permittedInsecurePackages = [ "freeimage-unstable-2021-11-01" ];
  };

  ########################################################
  # Small activation script as before (optional)
  ########################################################
  system.activationScripts = {
    text = ''
      echo 'Hey ${vars.user}! This script verifies sops secrets are available' > /home/${vars.user}/secretProof.txt
      echo $(cat ${config.sops.secrets.my-secret.path}) >> /home/${vars.user}/secretProof.txt || true
    '';
  };

  ########################################################
  # Home-manager defaults for your user (keine Änderungen)
  ########################################################
  home-manager.users.${vars.user} = {
    home.stateVersion = "25.05";
  };
}
